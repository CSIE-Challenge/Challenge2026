# ║                      工具函式                                   ║
# ╚══════════════════════════════════════════════════════════════════╝


## 根據難度等級（1-5）取得陣列中對應的值
## difficulty: 1~5 的整數
## 回傳：對應索引的值
static func get_val(arr: Array, difficulty: int):
	var idx = clampi(difficulty, 1, 5) - 1
	return arr[idx]
