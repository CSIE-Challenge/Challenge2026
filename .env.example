# Challenge2026 Server 環境設定
# 複製為 .env 後修改（請勿 commit .env）
#
# 本機開發：.env 放在 matchmaker/ 或 project root 皆可
# Docker：   放在 project root（docker-compose 會自動讀取）

# ── Matchmaker HTTP ──
HTTP_PORT=3000

# ── ENet port pool（每個房間吃 1 個 port，範圍大小決定最大同時房間數）──
PORT_RANGE_START=7777
PORT_RANGE_END=7778

# ── Godot（本機開發可指定 binary 路徑，Docker 內已內建）──
GODOT_BIN=godot
GODOT_PROJECT_PATH=.

# ── Game Server Address（傳回給 client 的連線位置）──
# 本機測試：127.0.0.1
# 部署：   請改為伺服器的 public IP 或 domain
GAME_IP=127.0.0.1
