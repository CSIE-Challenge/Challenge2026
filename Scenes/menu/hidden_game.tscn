[sub_resource type="Shader" id="Shader_edgefade"]
code = "shader_type canvas_item;
void fragment() {
    float alpha = smoothstep(0.0, 0.2, UV.y) * smoothstep(1.0, 0.8, UV.y);
    COLOR.a *= alpha;
}"

