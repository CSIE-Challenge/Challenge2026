[sub_resource type="Shader" id="Shader_shine"]
code = "shader_type canvas_item;
uniform float shine_progress : hint_range(0.0, 1.0) = 0.0;
uniform float shine_size : hint_range(0.01, 1.0) = 0.1;
uniform float shine_angle : hint_range(0.0, 89.9) = 45.0;

void fragment() {
    float rad = radians(shine_angle);
    float v = UV.x * cos(rad) + (1.0 - UV.y) * sin(rad);
    float max_v = cos(rad) + sin(rad);
    float progress = shine_progress * (max_v + shine_size * 2.0) - shine_size;
    float shine = step(v, progress + shine_size / 2.0) - step(v, progress - shine_size / 2.0);
    COLOR = vec4(1.0, 1.0, 1.0, shine * 0.8);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_shine"]
shader = SubResource("Shader_shine")
shader_parameter/shine_progress = 0.0
shader_parameter/shine_size = 0.1
shader_parameter/shine_angle = 45.0

